{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "cols=$(stty size </dev/tty 2>/dev/null | awk '{print $2}'); export COLUMNS=$(( ${cols:-120} > 4 ? ${cols:-120} - 4 : 1 )); plugin_dir=$(ls -1d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | sort -V | tail -1); exec /usr/local/bin/node \"${plugin_dir}dist/index.js\"",
    "padding": 0
  },
  "includeCoAuthoredBy": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/mirabilis/config/hooks/telegram-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/mirabilis/config/hooks/telegram-notify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
