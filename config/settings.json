{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash /home/node/.claude/statusline-command.sh",
    "padding": 0
  },
  "includeCoAuthoredBy": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/mirabilis/config/hooks/telegram-notify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/mirabilis/config/hooks/telegram-notify.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
