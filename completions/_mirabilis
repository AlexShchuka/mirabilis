#compdef mirabilis
_mirabilis() {
  local line state
  _arguments -C "1: :->cmds" "*::arg:->args"
  case "$state" in
    cmds)
      _values "mirabilis command" \
        "update[pull latest and rebuild, keeping memory]" \
        "down[stop the workspace]" \
        "restart[recreate the container]" \
        "token[replace a secret: gh|claude|context7]" \
        "check[show configured secrets]" \
        "completion[print the completion script]" \
        "version[print version]"
      ;;
    args)
      case "$line[1]" in
        token)      _values "secret" "gh" "claude" "context7" ;;
        completion) _values "shell" "zsh" ;;
      esac
      ;;
  esac
}
_mirabilis "$@"
