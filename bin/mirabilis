#!/usr/bin/env bash
if [ "${BASH_VERSINFO:-0}" -lt 4 ] && [ -z "${MIRABILIS_BASH_REEXEC:-}" ]; then
  for _bash in /opt/homebrew/bin/bash /usr/local/bin/bash /opt/local/bin/bash; do
    [ -x "$_bash" ] || continue
    export MIRABILIS_BASH_REEXEC=1
    exec "$_bash" "$0" "$@"
  done
fi
unset _bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DC="$REPO/scripts/dc.sh"
TOKEN="$REPO/scripts/token.sh"
VERSION="0.2.0"
SANDBOX_PROMPT="/opt/mirabilis/config/sandbox-context.md"
PROXY_PORT="${MIRABILIS_PROXY_PORT:-38128}"
PROXY_RUN="${TMPDIR:-/tmp}/mirabilis-proxy"
PROXY_PID="$PROXY_RUN.pid"
PROXY_CONF="$PROXY_RUN.conf"
PROXY_LOG="$PROXY_RUN.log"
BUILD_LOG="${TMPDIR:-/tmp}/mirabilis-build.log"

export DOCKER_CLI_HINTS=false

die() { echo "mirabilis: $*" >&2; exit 1; }
have_gum() { command -v gum >/dev/null 2>&1; }
open_host_url() {
  if command -v open >/dev/null 2>&1; then open "$1" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 || true
  fi
}

repo_version()      { git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown; }
container_version() { docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' mirabilis 2>/dev/null | sed -n 's/^MIRABILIS_VERSION=//p' | tr -d '[:space:]'; }
container_exists()  { docker container inspect mirabilis >/dev/null 2>&1; }
container_running() { [ "$(docker container inspect -f '{{.State.Running}}' mirabilis 2>/dev/null)" = "true" ]; }

ensure_tools() {
  if ! command -v docker >/dev/null 2>&1 || ! command -v devcontainer >/dev/null 2>&1; then
    echo "mirabilis: installing prerequisites (make bootstrap)…" >&2
    make -C "$REPO" bootstrap || die "bootstrap failed — see the output above"
  fi
  command -v mirabilis >/dev/null 2>&1 || {
    echo "mirabilis: putting the 'mirabilis' command on your PATH (make install)…" >&2
    make -C "$REPO" install || true
  }
}

ensure_extras() {
  command -v gum >/dev/null 2>&1 \
    || echo "mirabilis: optional tool 'gum' is missing — run 'make bootstrap' for the full UX." >&2
}

ensure_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed — run 'make bootstrap'."
  command -v devcontainer >/dev/null 2>&1 || die "devcontainer CLI is missing — run 'make bootstrap'."
  docker info >/dev/null 2>&1 && return 0
  [ -d /Applications/Docker.app ] || die "Docker daemon is not running — start Docker Desktop."
  echo "mirabilis: starting Docker Desktop…" >&2
  open -a Docker
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  die "Docker did not come up — open Docker Desktop and run 'mirabilis' again."
}

dc_up() {
  local rc=0
  if [ -t 2 ]; then
    : > "$BUILD_LOG"
    printf 'mirabilis: building the workspace… (full log: %s)\n' "$BUILD_LOG" >&2
    "$DC" up --workspace-folder "$REPO" "$@" >"$BUILD_LOG" 2>&1 </dev/null &
    local pid=$! n=0 cols line
    local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    cols="$(tput cols 2>/dev/null || echo 80)"
    while kill -0 "$pid" 2>/dev/null; do
      line="$(tail -n1 "$BUILD_LOG" 2>/dev/null | tr -d '\r' | sed -E 's/^\[[0-9T:.Z+-]+\] *//; s/^#[0-9]+ [0-9.]+ +//')"
      printf '\r\033[2K\033[36m%s\033[0m \033[2m%.*s\033[0m' \
        "${frames[n % 10]}" "$(( cols > 12 ? cols - 4 : 8 ))" "${line:-starting…}" >&2
      n=$((n + 1))
      sleep 0.2
    done
    wait "$pid" || rc=$?
    printf '\r\033[2K' >&2
  else
    echo "mirabilis: building / starting the workspace (log: $BUILD_LOG)…" >&2
    "$DC" up --workspace-folder "$REPO" "$@" >"$BUILD_LOG" 2>&1 || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    echo "mirabilis: workspace failed to start — last 40 log lines:" >&2
    tail -n 40 "$BUILD_LOG" >&2
    die "full build log: $BUILD_LOG"
  fi
}
up()      { dc_up; }
recreate(){ dc_up --remove-existing-container; }
dx()      { "$DC" exec --workspace-folder "$REPO" "$@"; }
dxq()     { "$DC" exec --workspace-folder "$REPO" "$@" </dev/null 2>/dev/null; }

proxy_running() {
  [ -f "$PROXY_PID" ] || return 1
  local pid; pid="$(cat "$PROXY_PID" 2>/dev/null)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

ensure_proxy() {
  command -v tinyproxy >/dev/null 2>&1 || die "tinyproxy is missing — run 'make bootstrap'."
  proxy_running && return 0
  printf 'Port %s\nListen 127.0.0.1\nTimeout 600\nAllow 127.0.0.1\nPidFile "%s"\nLogFile "%s"\n' \
    "$PROXY_PORT" "$PROXY_PID" "$PROXY_LOG" > "$PROXY_CONF"
  tinyproxy -c "$PROXY_CONF" >/dev/null 2>&1 || die "could not start the egress proxy (see $PROXY_LOG)."
}

stop_proxy() {
  if proxy_running; then kill "$(cat "$PROXY_PID" 2>/dev/null)" 2>/dev/null || true; fi
  rm -f "$PROXY_PID" 2>/dev/null || true
}

preflight() {
  local host_ip cont_ip code sb mcp msgs=""
  host_ip="$(curl -s -m 8 https://api.ipify.org 2>/dev/null || true)"
  cont_ip="$(dxq curl -s -m 8 https://api.ipify.org || true)"
  if [ -z "$cont_ip" ]; then
    msgs="$msgs"$'\n'"  egress: the container has no outbound — is the proxy up?"
  elif [ -n "$host_ip" ] && [ "$cont_ip" != "$host_ip" ]; then
    msgs="$msgs"$'\n'"  egress: container exits $cont_ip, host exits $host_ip — not routing through your host"
  fi
  code="$(dxq curl -s -o /dev/null -w '%{http_code}' -m 12 https://api.anthropic.com/v1/models || true)"
  case "${code:-000}" in
    200|401|403) ;;
    000) msgs="$msgs"$'\n'"  api.anthropic.com: unreachable" ;;
    *)   msgs="$msgs"$'\n'"  api.anthropic.com: HTTP $code" ;;
  esac
  sb="$(dxq bash -lc 'jq -r ".sandbox.enabled" ~/.claude/settings.json 2>/dev/null' || true)"
  [ "$sb" = true ] || msgs="$msgs"$'\n'"  sandbox: not enabled in settings"
  dxq bash -lc 'jq -e ".enabledPlugins[\"neuro-matrix@mirabilis\"]" ~/.claude/settings.json >/dev/null 2>&1' \
    || msgs="$msgs"$'\n'"  neuro-matrix: plugin not enabled (token?)"
  mcp="$(dxq claude mcp list || true)"
  printf '%s\n' "$mcp" | grep -qi github   || msgs="$msgs"$'\n'"  github MCP: not registered (token?)"
  printf '%s\n' "$mcp" | grep -qi context7 || msgs="$msgs"$'\n'"  context7 MCP: not registered"
  if [ -n "$msgs" ]; then
    printf 'mirabilis: preflight —%s\n' "$msgs" >&2
  else
    printf 'mirabilis: healthy — egress via your host (%s)\n' "${cont_ip:-?}" >&2
  fi
}

lifecycle() {
  cd "$REPO"
  . "$REPO/scripts/env.sh"
  docker compose -p mirabilis -f docker-compose.yml "$@"
}

rebuild_image() {
  lifecycle down >/dev/null 2>&1 || true
  docker image rm mirabilis:local >/dev/null 2>&1 || true
}

confirm() {
  local reply
  [ -t 0 ] || return 1
  if have_gum; then
    gum confirm "$1" --default=false
    return
  fi
  printf '%s [y/N] ' "$1" >/dev/tty 2>/dev/null || return 1
  read -r reply </dev/tty 2>/dev/null || return 1
  case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

is_stale() {
  local src cont
  src="$(repo_version)"; cont="$(container_version)"
  [ -z "$cont" ] && return 0
  [ "$src" = unknown ] && return 1
  [ "$cont" != "$src" ]
}

prompt_if_stale() {
  container_exists || return 0
  is_stale || return 0
  local cont; cont="$(container_version)"
  echo "mirabilis: the workspace container (${cont:-old}) is behind your checkout ($(repo_version))." >&2
  if confirm "mirabilis: rebuild it now? memory, auth and /workspace are kept"; then
    echo "mirabilis: rebuilding…" >&2
    rebuild_image
  else
    echo "mirabilis: keeping the existing container." >&2
  fi
}

pull_latest() {
  if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
    echo "mirabilis: the mirabilis repo has local changes — not pulling; commit or stash them first." >&2
    return 1
  fi
  if [ "$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)" != main ]; then
    git -C "$REPO" checkout main >/dev/null 2>&1 || { echo "mirabilis: could not switch to the main branch." >&2; return 1; }
  fi
  GIT_TERMINAL_PROMPT=0 git -C "$REPO" pull --ff-only >/dev/null 2>&1 || { echo "mirabilis: pull failed (diverged or offline) — resolve manually." >&2; return 1; }
}

prompt_if_outdated() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || return 0
  GIT_TERMINAL_PROMPT=0 git -C "$REPO" fetch -q origin 2>/dev/null || return 0
  git -C "$REPO" rev-parse --verify -q origin/main >/dev/null 2>&1 || return 0
  local behind; behind="$(git -C "$REPO" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  [ "${behind:-0}" -gt 0 ] || return 0
  echo "mirabilis: a newer version is available ($(repo_version) → $(git -C "$REPO" rev-parse --short origin/main), $behind commit(s) behind)." >&2
  confirm "mirabilis: update now? switches to main, pulls, rebuilds" || { echo "mirabilis: keeping the current version." >&2; return 0; }
  pull_latest || return 0
  echo "mirabilis: updated to $(repo_version) — rebuilding and relaunching…" >&2
  MIRABILIS_REBUILD=1 exec "$REPO/bin/mirabilis"
}

ensure_github() {
  dx gh auth status >/dev/null 2>&1 && return 0
  echo "mirabilis: first run — signing in to GitHub. Your Mac browser will open github.com/login/device; type the one-time code shown below and approve." >&2
  open_host_url "https://github.com/login/device"
  dx env GH_BROWSER=true BROWSER=true gh auth login --hostname github.com --git-protocol https --web || die "GitHub sign-in failed — run 'mirabilis' again"
  dx gh auth setup-git || true
  dx bash -lc 't="$(gh auth token 2>/dev/null)"; [ -n "$t" ] && GITHUB_TOKEN="$t" /usr/local/bin/provision-mcp.sh >/dev/null 2>&1 || true'
}

ensure_claude() {
  dxq bash -lc '[ -s "$HOME/.claude/.credentials.json" ] || [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]' && return 0
  echo "mirabilis: Claude needs sign-in. Recommended: run 'mirabilis token claude' for headless auth (no browser; persists across rebuilds — re-run 'mirabilis restart' if the workspace is already up). Otherwise complete the sign-in Claude shows next: it prints a URL to open in your browser; approve, then paste the code back here. Saved for next time." >&2
}

system_prompt_file() {
  dx bash -lc '
    sbx="$1"; out=/tmp/mirabilis-system-prompt.md
    nm="$(ls -1 /home/node/.claude/plugins/cache/*/neuro-matrix/*/CLAUDE.md 2>/dev/null | sort -V | tail -n1)"
    if [ -n "$nm" ] && [ -f "$nm" ]; then cat "$sbx" "$nm" >"$out" && { printf %s "$out"; exit 0; }; fi
    printf "mirabilis: WARNING — neuro-matrix CLAUDE.md not found; using the sandbox note only\n" >&2
    printf %s "$sbx"
  ' _ "$SANDBOX_PROMPT"
}

launch() {
  ensure_tools
  ensure_extras
  ensure_docker
  prompt_if_outdated
  local fresh=1
  if [ -n "${MIRABILIS_REBUILD:-}" ]; then
    rebuild_image
  elif container_running && ! is_stale; then
    fresh=0
  else
    prompt_if_stale
  fi
  ensure_proxy
  if [ "$fresh" = 1 ]; then
    up
    ensure_github
    ensure_claude
    preflight
  fi
  local ght; ght="$(dxq gh auth token || true)"
  exec "$DC" exec --workspace-folder "$REPO" env GITHUB_PERSONAL_ACCESS_TOKEN="$ght" COLORTERM=truecolor TERM=xterm-256color claude --dangerously-skip-permissions --append-system-prompt-file "$(system_prompt_file)"
}

update() {
  ensure_tools
  ensure_docker
  echo "mirabilis: updating source…" >&2
  pull_latest || echo "mirabilis: rebuilding the current source instead." >&2
  echo "mirabilis: rebuilding image + container — memory, auth and /workspace are kept…" >&2
  rebuild_image
  up
  echo "mirabilis: updated to $(repo_version) — run 'mirabilis' to start." >&2
}

print_completion() {
  case "${1:-zsh}" in
    zsh) cat "$REPO/completions/_mirabilis" ;;
    *)   die "only zsh completion is bundled" ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
mirabilis — autonomous Claude Code workspace

  mirabilis            start the workspace and open Claude
                       (first run self-installs + builds; after that this is
                        the only command you need)
  mirabilis update     pull the latest version and rebuild from scratch
                       (your memory, auth and /workspace are kept)

Other commands:
  mirabilis down|restart     stop / recreate the workspace
  mirabilis token gh|claude|context7   replace a stored secret
  mirabilis check            show which secrets are set
  mirabilis completion zsh   print the zsh completion script
  mirabilis version
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$c" in
    ""|claude|run|up)     launch ;;
    update|upgrade)       update ;;
    down)                 lifecycle down; stop_proxy ;;
    restart)              ensure_docker; recreate; echo "restarted." >&2 ;;
    token)                "$TOKEN" set "${1:-}" ;;
    check)                "$TOKEN" check ;;
    completion)           print_completion "${1:-zsh}" ;;
    version|-v|--version) echo "mirabilis $VERSION ($(repo_version))" ;;
    help|-h|--help)       usage ;;
    *)                    die "unknown command '$c' (run 'mirabilis help')" ;;
  esac
}

main "$@"
