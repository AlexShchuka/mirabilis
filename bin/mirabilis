#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DC="$REPO/scripts/dc.sh"
TOKEN="$REPO/scripts/token.sh"
DOCTOR="$REPO/scripts/doctor.sh"
VERSION="0.2.0"

die() { echo "mirabilis: $*" >&2; exit 1; }
missing() { "$TOKEN" check 2>/dev/null | grep -qE "^$1 .*MISSING"; }

ensure_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed — run 'make bootstrap'."
  command -v devcontainer >/dev/null 2>&1 || die "devcontainer CLI is missing — run 'make bootstrap'."
  docker info >/dev/null 2>&1 && return 0
  [ -d /Applications/Docker.app ] || die "Docker daemon is not running — start Docker Desktop."
  echo "mirabilis: starting Docker Desktop…" >&2
  open -a Docker
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  die "Docker did not come up — open Docker Desktop and run 'mirabilis' again."
}

up()      { "$DC" up --workspace-folder "$REPO" >/dev/null; }
recreate(){ "$DC" up --workspace-folder "$REPO" --remove-existing-container >/dev/null; }
dx()      { "$DC" exec --workspace-folder "$REPO" "$@"; }

lifecycle() {
  cd "$REPO"
  set -a; [[ -f .env ]] && . ./.env; set +a
  : "${WORKSPACE_DIR:=$HOME/mirabilis-workspace}"; export WORKSPACE_DIR
  docker compose -p mirabilis -f docker-compose.yml "$@"
}

ensure_github() {
  missing gh || return 0
  cat >&2 <<'EOF'

First run — I need a GitHub token (private repos + the GitHub MCP).
Create one at https://github.com/settings/tokens (scope: repo), then paste it.
EOF
  "$TOKEN" set gh
}

ensure_claude() {
  missing claude || return 0
  cat >&2 <<'EOF'

First run — Claude needs a one-time login on your subscription.
A URL/code appears: open it (VPN to a supported region ON), approve, paste the token back.
EOF
  dx claude setup-token || die "Claude login failed — make sure the VPN is on, then run 'mirabilis' again."
  "$TOKEN" set claude
  recreate
}

launch() {
  ensure_docker
  ensure_github
  up
  ensure_claude
  exec "$DC" exec --workspace-folder "$REPO" claude --dangerously-skip-permissions
}

print_completion() {
  case "${1:-zsh}" in
    zsh) cat "$REPO/completions/_mirabilis" ;;
    *)   die "only zsh completion is bundled" ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
mirabilis — autonomous Claude Code workspace

  mirabilis            start the workspace and open Claude
                       (the first run sets up tokens + login automatically;
                        every run after, this is the only command you need)

Optional, only if you ever want them:
  mirabilis agent "<task>"   run one prompt non-interactively and exit
  mirabilis shell            a shell in the workspace as node
  mirabilis doctor           health check
  mirabilis down|restart     stop / recreate the workspace
  mirabilis token gh|claude|context7   replace a stored secret
  mirabilis check            show which secrets are set
  mirabilis completion zsh   print the zsh completion script
  mirabilis version
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$c" in
    ""|claude|run|up)     launch ;;
    agent)                [ -n "${1:-}" ] || die "give a prompt: mirabilis agent \"...\""
                          ensure_docker; up
                          exec "$DC" exec --workspace-folder "$REPO" claude -p "$1" --dangerously-skip-permissions ;;
    shell)                ensure_docker; up
                          exec "$DC" exec --workspace-folder "$REPO" bash ;;
    doctor)               "$DOCTOR" ;;
    down)                 lifecycle down ;;
    restart)              ensure_docker; recreate; echo "restarted." >&2 ;;
    token)                "$TOKEN" set "${1:-}" ;;
    check)                "$TOKEN" check ;;
    completion)           print_completion "${1:-zsh}" ;;
    version|-v|--version) echo "mirabilis $VERSION" ;;
    help|-h|--help)       usage ;;
    *)                    die "unknown command '$c' (run 'mirabilis help')" ;;
  esac
}

main "$@"
