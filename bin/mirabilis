#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE="$REPO/scripts/compose.sh"
TOKEN="$REPO/scripts/token.sh"
DOCTOR="$REPO/scripts/doctor.sh"
VERSION="0.1.0"

die() { echo "mirabilis: $*" >&2; exit 1; }
missing() { "$TOKEN" check 2>/dev/null | grep -qE "^$1 .*MISSING"; }

start_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed — run 'make bootstrap' once."
  docker info >/dev/null 2>&1 && return 0
  [ -d /Applications/Docker.app ] || die "Docker daemon is not running — start Docker Desktop."
  echo "mirabilis: starting Docker Desktop…" >&2
  open -a Docker
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  die "Docker did not come up — open Docker Desktop and run 'mirabilis' again."
}

ensure_image() {
  docker image inspect mirabilis:local >/dev/null 2>&1 && return 0
  echo "mirabilis: building the workspace image (first run, a few minutes)…" >&2
  "$COMPOSE" build
}

ensure_github() {
  missing gh || return 0
  cat >&2 <<'EOF'

First run — I need a GitHub token (for your private repos + the GitHub MCP).
Create one at https://github.com/settings/tokens (scope: repo), then paste it.
EOF
  "$TOKEN" set gh
}

ensure_claude() {
  missing claude || return 0
  cat >&2 <<'EOF'

First run — Claude needs a one-time login on your subscription.
A URL/code will appear: open it in your browser (VPN to a supported region must be ON),
approve, then paste the printed token back here.
EOF
  "$COMPOSE" exec -it --user coder mirabilis claude setup-token \
    || die "Claude login failed — make sure the VPN is on, then run 'mirabilis' again."
  "$TOKEN" set claude
  "$COMPOSE" up -d --force-recreate >/dev/null
}

launch() {
  start_docker
  ensure_image
  ensure_github
  "$COMPOSE" up -d --no-recreate >/dev/null
  ensure_claude
  exec "$COMPOSE" exec -it --user coder -w /workspace mirabilis claude --dangerously-skip-permissions
}

print_completion() {
  case "${1:-zsh}" in
    zsh) cat "$REPO/completions/_mirabilis" ;;
    *)   die "only zsh completion is bundled" ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
mirabilis — autonomous Claude Code workspace

  mirabilis            start the workspace and open Claude
                       (the first run sets up tokens + login automatically;
                        every run after, this is the only command you need)

Optional, only if you ever want them:
  mirabilis agent "<task>"   run one prompt non-interactively and exit
  mirabilis shell            a shell in the workspace as coder
  mirabilis doctor           health check
  mirabilis down|restart     stop / recreate the workspace
  mirabilis logs             tail logs
  mirabilis token gh|claude|context7   replace a stored secret
  mirabilis check            show which secrets are set
  mirabilis completion zsh   print the zsh completion script
  mirabilis version
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$c" in
    ""|claude|run|up)     launch ;;
    agent)                [ -n "${1:-}" ] || die "give a prompt: mirabilis agent \"...\""
                          start_docker; ensure_image; "$COMPOSE" up -d --no-recreate >/dev/null
                          exec "$COMPOSE" exec -T --user coder -w /workspace mirabilis claude -p "$1" --dangerously-skip-permissions ;;
    shell)                start_docker; "$COMPOSE" up -d --no-recreate >/dev/null
                          exec "$COMPOSE" exec -it --user coder -w /workspace mirabilis bash ;;
    doctor)               "$DOCTOR" ;;
    down)                 "$COMPOSE" down ;;
    restart)              start_docker; "$COMPOSE" up -d --force-recreate >/dev/null; echo "restarted." >&2 ;;
    logs)                 "$COMPOSE" logs -f --tail=120 ;;
    token)                "$TOKEN" set "${1:-}" ;;
    check)                "$TOKEN" check ;;
    completion)           print_completion "${1:-zsh}" ;;
    version|-v|--version) echo "mirabilis $VERSION" ;;
    help|-h|--help)       usage ;;
    *)                    die "unknown command '$c' (run 'mirabilis help')" ;;
  esac
}

main "$@"
