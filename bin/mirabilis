#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
DC="$REPO/scripts/dc.sh"
TOKEN="$REPO/scripts/token.sh"
DOCTOR="$REPO/scripts/doctor.sh"
VERSION="0.2.0"
SANDBOX_PROMPT="/opt/mirabilis/config/sandbox-context.md"

die() { echo "mirabilis: $*" >&2; exit 1; }
open_host_url() { command -v open >/dev/null 2>&1 && open "$1" >/dev/null 2>&1 || true; }

repo_version()      { git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown; }
container_version() { docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' mirabilis 2>/dev/null | sed -n 's/^MIRABILIS_VERSION=//p' | tr -d '[:space:]'; }
container_exists()  { docker container inspect mirabilis >/dev/null 2>&1; }

ensure_tools() {
  if ! command -v docker >/dev/null 2>&1 || ! command -v devcontainer >/dev/null 2>&1; then
    echo "mirabilis: installing prerequisites (make bootstrap)…" >&2
    make -C "$REPO" bootstrap || die "bootstrap failed — see the output above"
  fi
  command -v mirabilis >/dev/null 2>&1 || {
    echo "mirabilis: putting the 'mirabilis' command on your PATH (make install)…" >&2
    make -C "$REPO" install || true
  }
}

ensure_docker() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed — run 'make bootstrap'."
  command -v devcontainer >/dev/null 2>&1 || die "devcontainer CLI is missing — run 'make bootstrap'."
  docker info >/dev/null 2>&1 && return 0
  [ -d /Applications/Docker.app ] || die "Docker daemon is not running — start Docker Desktop."
  echo "mirabilis: starting Docker Desktop…" >&2
  open -a Docker
  for _ in $(seq 1 60); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  die "Docker did not come up — open Docker Desktop and run 'mirabilis' again."
}

up()      { "$DC" up --workspace-folder "$REPO" >/dev/null; }
recreate(){ "$DC" up --workspace-folder "$REPO" --remove-existing-container >/dev/null; }
dx()      { "$DC" exec --workspace-folder "$REPO" "$@"; }

lifecycle() {
  cd "$REPO"
  set -a; [[ -f .env ]] && . ./.env; set +a
  : "${WORKSPACE_DIR:=$HOME/mirabilis-workspace}"; export WORKSPACE_DIR
  docker compose -p mirabilis -f docker-compose.yml "$@"
}

rebuild_image() {
  lifecycle down >/dev/null 2>&1 || true
  docker image rm mirabilis:local >/dev/null 2>&1 || true
}

confirm() {
  local reply
  [ -t 0 ] || return 1
  read -r -p "$1 [y/N] " reply </dev/tty 2>/dev/null || return 1
  case "$reply" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

is_stale() {
  local src cont
  src="$(repo_version)"; cont="$(container_version)"
  [ -z "$cont" ] && return 0
  [ "$src" = unknown ] && return 1
  [ "$cont" != "$src" ]
}

prompt_if_stale() {
  container_exists || return 0
  is_stale || return 0
  local cont; cont="$(container_version)"
  echo "mirabilis: the workspace container (${cont:-old}) is behind your checkout ($(repo_version))." >&2
  if confirm "mirabilis: rebuild it now? memory, auth and /workspace are kept"; then
    echo "mirabilis: rebuilding…" >&2
    rebuild_image
  else
    echo "mirabilis: keeping the existing container." >&2
  fi
}

pull_latest() {
  if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then
    echo "mirabilis: the mirabilis repo has local changes — not pulling; commit or stash them first." >&2
    return 1
  fi
  if [ "$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)" != main ]; then
    git -C "$REPO" checkout main >/dev/null 2>&1 || { echo "mirabilis: could not switch to the main branch." >&2; return 1; }
  fi
  GIT_TERMINAL_PROMPT=0 git -C "$REPO" pull --ff-only >/dev/null 2>&1 || { echo "mirabilis: pull failed (diverged or offline) — resolve manually." >&2; return 1; }
}

prompt_if_outdated() {
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || return 0
  GIT_TERMINAL_PROMPT=0 git -C "$REPO" fetch -q origin 2>/dev/null || return 0
  git -C "$REPO" rev-parse --verify -q origin/main >/dev/null 2>&1 || return 0
  local behind; behind="$(git -C "$REPO" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  [ "${behind:-0}" -gt 0 ] || return 0
  echo "mirabilis: a newer version is available ($(repo_version) → $(git -C "$REPO" rev-parse --short origin/main), $behind commit(s) behind)." >&2
  confirm "mirabilis: update now? switches to main, pulls, rebuilds" || { echo "mirabilis: keeping the current version." >&2; return 0; }
  pull_latest || return 0
  echo "mirabilis: updated to $(repo_version) — rebuilding and relaunching…" >&2
  MIRABILIS_REBUILD=1 exec "$REPO/bin/mirabilis"
}

ensure_github() {
  dx gh auth status >/dev/null 2>&1 && return 0
  echo "mirabilis: first run — signing in to GitHub. Your Mac browser will open github.com/login/device; type the one-time code shown below and approve." >&2
  open_host_url "https://github.com/login/device"
  dx env GH_BROWSER=true gh auth login --hostname github.com --git-protocol https --web || die "GitHub sign-in failed — run 'mirabilis' again"
  dx gh auth setup-git || true
  dx bash -lc 't="$(gh auth token 2>/dev/null)"; [ -n "$t" ] && GITHUB_TOKEN="$t" /usr/local/bin/provision-mcp.sh >/dev/null 2>&1 || true'
}

ensure_claude() {
  dx bash -lc 'test -s "$HOME/.claude/.credentials.json"' && return 0
  echo "mirabilis: first run — Claude will print a sign-in URL; open it in your Mac browser, approve, and paste the code back here. It is saved for next time." >&2
}

system_prompt_file() {
  dx bash -lc '
    sbx="$1"; out=/tmp/mirabilis-system-prompt.md
    nm="$(ls -1 /home/node/.claude/plugins/cache/*/neuro-matrix/*/CLAUDE.md 2>/dev/null | sort -V | tail -n1)"
    if [ -n "$nm" ] && [ -f "$nm" ]; then cat "$sbx" "$nm" >"$out" && { printf %s "$out"; exit 0; }; fi
    printf "mirabilis: WARNING — neuro-matrix CLAUDE.md not found; using the sandbox note only\n" >&2
    printf %s "$sbx"
  ' _ "$SANDBOX_PROMPT"
}

launch() {
  ensure_tools
  ensure_docker
  prompt_if_outdated
  if [ -n "${MIRABILIS_REBUILD:-}" ]; then rebuild_image; else prompt_if_stale; fi
  up
  ensure_github
  ensure_claude
  exec "$DC" exec --workspace-folder "$REPO" claude --dangerously-skip-permissions --append-system-prompt-file "$(system_prompt_file)"
}

update() {
  ensure_tools
  ensure_docker
  echo "mirabilis: updating source…" >&2
  pull_latest || echo "mirabilis: rebuilding the current source instead." >&2
  echo "mirabilis: rebuilding image + container — memory, auth and /workspace are kept…" >&2
  rebuild_image
  up
  echo "mirabilis: updated to $(repo_version) — run 'mirabilis' to start." >&2
}

print_completion() {
  case "${1:-zsh}" in
    zsh) cat "$REPO/completions/_mirabilis" ;;
    *)   die "only zsh completion is bundled" ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
mirabilis — autonomous Claude Code workspace

  mirabilis            start the workspace and open Claude
                       (first run self-installs + builds; after that this is
                        the only command you need)
  mirabilis update     pull the latest version and rebuild from scratch
                       (your memory, auth and /workspace are kept)

Other commands:
  mirabilis doctor           health check
  mirabilis down|restart     stop / recreate the workspace
  mirabilis token gh|claude|context7   replace a stored secret
  mirabilis check            show which secrets are set
  mirabilis completion zsh   print the zsh completion script
  mirabilis version
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$c" in
    ""|claude|run|up)     launch ;;
    update|upgrade)       update ;;
    doctor)               "$DOCTOR" ;;
    down)                 lifecycle down ;;
    restart)              ensure_docker; recreate; echo "restarted." >&2 ;;
    token)                "$TOKEN" set "${1:-}" ;;
    check)                "$TOKEN" check ;;
    completion)           print_completion "${1:-zsh}" ;;
    version|-v|--version) echo "mirabilis $VERSION ($(repo_version))" ;;
    help|-h|--help)       usage ;;
    *)                    die "unknown command '$c' (run 'mirabilis help')" ;;
  esac
}

main "$@"
